[
 {
  "doctype": "Print Format",
  "name": "QA Certificate",
  "module": "Quality Asia LMS",
  "doc_type": "LMS Certificate",
  "print_format_type": "Jinja",
  "custom_format": 1,
  "standard": "No",
  "disabled": 0,
  "print_format_builder": 0,
  "default_print_language": "en",
  "pdf_generator": "wkhtmltopdf",
  "margin_top": 10,
  "margin_bottom": 10,
  "margin_left": 10,
  "margin_right": 10,
  "align_labels_right": 0,
  "show_section_headings": 0,
  "line_breaks": 0,
  "font_size": 14,
  "page_number": "Hide",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n\t<meta charset=\"UTF-8\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\t<style type=\"text/css\">\n\t\tbody {\n\t\t\tfont-family: Arial, sans-serif;\n\t\t\tmargin: 0;\n\t\t\tpadding: 0;\n\t\t\tdisplay: flex;\n\t\t\tjustify-content: center;\n\t\t\talign-items: center;\n\t\t\theight: 100vh;\n\t\t\tbackground-color: #f0f0f0;\n\t\t}\n\n\t\tp, h1, h2, h3, h4, h5, h6 {\n\t\t\tmargin-bottom: 0;\n\t\t\tfont-weight: 500;\n\t\t}\n\n\t\t.print-preview {\n\t\t    background: transparent !important;\n\t\t}\n\n\t\t.certificate {\n\t\t\tposition: relative;\n\t\t\theight: 100%;\n\t\t\tborder: 10px solid #e20b0a;\n\t\t\tbox-sizing: border-box;\n\t\t}\n\n\t\timg.cert-bg {\n\t\t\tmax-height: 100%;\n\t\t}\n\n\t\t.text-container {\n\t\t\ttext-align: center;\n\t\t\tbackground: #ffffff;\n\t\t\theight: 100%;\n\t\t\tpadding-bottom: 2rem;\n\t\t}\n\n\t\t.cert-heading {\n\t\t    margin-top: 30px;\n\t\t    font-size: 32px;\n\t\t}\n\n\t\t.cert-content {\n\t\t    font-size: 20px;\n\t\t    line-height: 50px;\n\t\t    font-weight: 300;\n\t\t    margin: 5.2rem 0 5rem !important;\n\t\t}\n\n\t\t.var {\n\t\t    border-bottom: 1px dashed #000;\n\t\t    display: inline-block;\n\t\t    font-weight: 900;\n\t\t}\n\n\t\t.name {\n\t\t    width: 300px;\n\t\t}\n\n\t\t.program {\n\t\t    width: 300px;\n\t\t}\n\n\t\t.issue-date {\n\t\t    width: 300px;\n\t\t}\n\n\t\t.auditor {\n\t\t    width: 340px;\n\t\t}\n\n\t\t.cert-table td {\n\t\t    vertical-align: bottom !important;\n\t\t}\n\n\t\t.qasia-logo {\n\t\t    width: 200px;\n\t\t    margin-top: 30px;\n\t\t}\n\n\t\t.qasia-logo-footer {\n\t\t    width: 220px;\n\t\t    margin-top: 30px;\n\t\t}\n\n\t\t.footer-address {\n\t\t    font-size: 16px;\n\t\t}\n\n\t\th2 {\n\t\t\tfont-weight: 700;\n\t\t\tfont-size: 32px;\n\t\t\tline-height: 38px;\n\t\t}\n\n\t\th6 {\n\t\t\tfont-size: 16px;\n\t\t}\n\n\t\t.cert-data-container {\n\t\t    margin-bottom: 2rem;\n\t\t}\n\n\t\t.data-item {\n\t\t\tfont-size: 14px;\n\t\t\tmargin-bottom: .5rem;\n\t\t\ttext-align: center;\n\t\t}\n\n\t\t.data-item img {\n\t\t    width: 180px;\n\t\t}\n\n\t\t.item-key {\n\t\t\tfont-weight: bold;\n\t\t}\n\n\t\t.footer h6 {\n\t\t\tmargin: 10px 0 10px;\n\t\t}\n\n\t\t.footer img {\n\t\t    margin: -30px 20px;\n\t\t}\n\n\t\t.signature-image {\n\t\t\twidth: 100%;\n\t\t\tmax-width: 12rem;\n\t\t\tborder-bottom: 1px solid #919191;\n\t\t}\n\n\t\ttable {\n\t\t    table-layout: fixed;\n\t\t    width: 100%;\n\t\t}\n\n\t\t/* --- QA single-page fit (do not remove) ---\n\t\t   Frappe renders this template inside <div class=\"print-format\"> whose\n\t\t   min-height:11.69in (one full A4) plus the page margins overflowed a\n\t\t   blank 2nd page. Neutralise the wrapper's forced height, give the card a\n\t\t   page-height min-height and pin the footer to the bottom so the whole\n\t\t   certificate fills most of one page. position:absolute + min-height only\n\t\t   (no flexbox) for reliable wkhtmltopdf rendering.\n\t\t   min-height is 250mm (NOT the full ~263mm printable height): the Frappe\n\t\t   Cloud server renders content ~10-15pt taller than local (font metrics),\n\t\t   which pushed a fixed full-height card past the page-break point and spilled\n\t\t   a blank 2nd page. 250mm leaves ~15mm of headroom (verified by sweeping the\n\t\t   wkhtmltopdf top margin) so server font variance + 2-line names/titles still\n\t\t   fit on one page. Do not raise it back toward the page height. */\n\t\t.print-format, .print-format-gutter { min-height: 0 !important; height: auto !important; padding: 0 !important; margin: 0 !important; }\n\t\thtml, body { height: auto !important; display: block !important; background: #fff !important; }\n\t\t.certificate { height: auto !important; position: relative !important; }\n\t\t.text-container { height: auto !important; min-height: 250mm !important; padding-bottom: 78px !important; box-sizing: border-box !important; }\n\t\t.footer { position: absolute !important; bottom: 22px !important; left: 0 !important; right: 0 !important; }\n\t</style>\n\t<title>Certificate</title>\n</head>\n<body>\n\t<div class=\"certificate\">\n\t\t<div class=\"text-container\">\n\t\t    <img class=\"qasia-logo\" src=\"{{ qa_cert_image('header.jpg') }}\" alt=\"Quality Asia\" />\n\t\t    <h4 class=\"cert-heading\">TRAINING CERTIFICATE</h4>\n\t\t    <p class=\"cert-content\">THIS IS TO CERTIFY THAT <span class=\"var name\">{{ doc.candidate_name_as_printed or doc.member_name }}</span> <br/> HAS SUCESSFULLY COMPLETED\n\t\t    <span class=\"var program\">{{ doc.course_title }}</span> <br/> <span class=\"var auditor\">INTERNAL AUDITOR</span> TRAINING PROGRAM <br/>\n\t\t    CONDUCTED ON <span class=\"var issue-date\">{{ doc.training_dates or format_training_dates(doc.training_start_date, doc.training_end_date) }}</span></p>\n\t\t\t<div class=\"cert-data-container\">\n\t\t\t\t<table class=\"cert-table\">\n                \t<tr>\n                \t\t<td>\n                \t\t\t<div class=\"data-item\">\n                \t\t\t\t<p class=\"item-key\">CERTIFICATE NO</p>\n                \t\t\t\t<p class=\"item-value\">{{ doc.name }}</p>\n                \t\t\t</div>\n                \t\t</td>\n                \t\t<td>\n                \t\t\t<div class=\"data-item\">\n                \t\t\t\t<p class=\"item-key\">DATE OF ISSUE</p>\n                \t\t\t\t<p class=\"item-value\">{{ doc.get_formatted(\"issue_date\") }}</p>\n                \t\t\t</div>\n                \t\t</td>\n                \t\t<td>\n                \t\t\t<div class=\"data-item\">\n                \t\t\t\t<p class=\"item-key\"><img class=\"signature-image\" src=\"{{ qa_cert_image('signature.jpg') }}\" alt=\"Authorised Signatory\" /></p>\n                \t\t\t\t<p class=\"item-value\">AUTHORISED SIGNATORY</p>\n                \t\t\t</div>\n                \t\t</td>\n                \t</tr>\n                </table>\n\t\t\t</div>\n\t\t\t<div class=\"footer\">\n\t\t\t\t<h6>CONDUCTED BY</h6>\n\t\t\t\t<img class=\"qasia-logo-footer\" src=\"{{ qa_cert_image('footer.png') }}\" alt=\"Quality Asia\" />\n\t\t\t\t<h6>www.qualityasia.in</h6>\n\t\t\t\t<p class=\"footer-address\">212 Bhera Enclave, Paschim Vihar, Delhi - 110087</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</body>\n</html>\n"
 }
